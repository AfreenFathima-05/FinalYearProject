# Copy this file to .env and adjust values. Never commit the real .env file.

# Application
APP_NAME=ResQLink API
APP_ENV=development
APP_DEBUG=true

# CORS (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL) - not used yet; placeholder for later steps
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/<db_name>

# Security - not used yet; placeholders for later steps
SECRET_KEY=<generate-a-long-random-secret>
